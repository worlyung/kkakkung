# Supabase PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 private bucket. Do not make the bucket public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
